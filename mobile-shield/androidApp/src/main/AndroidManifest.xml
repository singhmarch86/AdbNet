<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Device-hygiene checkup: enumerate installed apps to flag risky ones.
         QUERY_ALL_PACKAGES is a sensitive permission; it is justified here for a
         security app and must be declared to the Play Store. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Downloaded-APK scan: read the public Downloads folder. On API <= 32
         this permission is enough; on 33+ full coverage of other apps'
         downloads needs MANAGE_EXTERNAL_STORAGE, which we deliberately do NOT
         request (the scan is then limited to what scoped storage exposes). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Live payment protection: detect an active call, draw the warning over
         the payment app, and run the monitor as a foreground service. Usage
         access (foreground-app detection) is a special grant the user enables
         in Settings, so it is not declared here. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Optional SMS auto-scan. Google Play restricts SMS permissions to the
         default SMS handler, so this is mainly for sideload/enterprise builds;
         the in-app "check a message" card needs no permission. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- QR code scanning. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Let the user SHARE a UPI link/text to the app to have it checked.
                 We deliberately do NOT register as a handler for upi:// links, so
                 real payment flows are never intercepted. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Local-only DNS filtering VPN. No traffic leaves the device except
             the forwarded DNS queries for names that are allowed. -->
        <service
            android:name=".ShieldVpnService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Live payment-moment monitor (foreground service). -->
        <service
            android:name=".guard.PaymentGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="scam_protection" />
        </service>

        <!-- Optional, opt-in accessibility enhancement (window-level only). -->
        <service
            android:name=".guard.ShieldAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Device admin for OS-level enforcement (only effective when the app
             is provisioned as device owner; see policy/ for details). -->
        <receiver
            android:name=".policy.ShieldDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Optional incoming-SMS smishing scan (see RECEIVE_SMS note above). -->
        <receiver
            android:name=".smishing.SmsSmishingReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
